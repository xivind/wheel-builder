# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
.venv/
venv/
ENV/

# Environment variables
.env
.envrc

# Testing
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Type checking
.mypy_cache/

# Logs
*.log

# Git worktrees
.worktrees/

# Database
data/

# graphify - local-only cost log
graphify-out/cost.json

# graphify - mtime (not content) drives a strict-mode freshness check; git
# doesn't preserve mtimes across clones, so committing this never helps and
# can feed the check a bogus checkout-time stamp
graphify-out/cache/last_query_stamp

# graphify - machine-local absolute paths (would break on any other clone)
graphify-out/.graphify_python
graphify-out/.graphify_root

# graphify - install-time safety backup, not needed long-term
.claude/settings.json.graphify-bak

# graphify - dated auto-backup, created automatically before overwriting a
# graph that cost real LLM tokens or has curated labels; git history already
# covers this, so committing it only accumulates clutter
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/