{"nodes": [{"id": "claude_wheel_builder_project", "label": "Wheel Builder (project overview)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "Project Overview", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_three_layer_architecture", "label": "Strict Three-Layer Architecture", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Architecture > Strict Layer Separation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "main.py routes only, business_logic.py holds all calculations and orchestration and must go through database_manager.py, which alone touches Peewee models. Keeps boundaries clean; violating them is explicitly forbidden."}, {"id": "claude_routing_layer", "label": "Routing Layer (main.py)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_business_logic_layer", "label": "Business Logic Layer (business_logic.py)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_data_access_layer", "label": "Data Access Layer (database_manager.py)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_logging_guidelines", "label": "Logging Guidelines (standard logging, no logger.py)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Logging Guidelines / Logging", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every module uses logging.getLogger(__name__) with consistent level semantics (info=lifecycle/CRUD, debug=diagnostics, warning=non-critical, error=failures). Unified format via uvicorn_log_config.ini, dual stdout+rotating file output (3 x 10KB)."}, {"id": "claude_spoke_length_calculation", "label": "Spoke Length Calculation", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Key Features > Spoke Length Calculation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Left and right lengths computed separately because hub flanges are asymmetric; formula sqrt((R - r cos a)^2 + offset^2 + (r sin a)^2) - nipple_length."}, {"id": "claude_tension_tracking_system", "label": "Tension Tracking System", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Key Features > Tension Tracking System", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_deviation_tracking_dual_approach", "label": "Deviation Tracking (Dual Approach)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Tension Tracking System > Deviation Tracking", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "average_deviation_status (+/-20% threshold) is stored and rewritten for ALL readings on any change to avoid stale data and allow queries; deviation_pct is computed on the fly for display only, with color-coded badges refreshed via HTMX."}, {"id": "claude_quality_status_logic", "label": "Quality Status Logic (Industry Standards)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Tension Tracking System > Quality Status Logic", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Well Balanced (<5% std dev, none >10%), Needs Truing (5-10%), Uneven Tension (>10% or spokes >20%), Out of Range (outside spoke type limits)."}, {"id": "claude_session_independence", "label": "Session Independence", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Tension Tracking System > Session Independence", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each session has its own readings, averages and deviation percentages so editing or fixing one session never affects others; supports editing an active session for weeks then starting a new one after riding."}, {"id": "claude_component_locking", "label": "Component Locking", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Key Features > Component Locking", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Components used by a wheel build cannot be edited or deleted, preserving build history integrity; implemented via get_builds_using_*() in database_manager.py."}, {"id": "claude_park_tool_tm1_conversion", "label": "Park Tool TM-1 Conversion System", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Key Features > Park Tool TM-1 Conversion System", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Industry-standard tension meter calibration; conversion_table.txt maps TM-1 readings 0-40 to kgf per spoke type, with linear interpolation."}, {"id": "claude_conversion_table", "label": "conversion_table.txt (TM-1 calibration table)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "Park Tool TM-1 Conversion System", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_uuid_primary_keys", "label": "UUID Primary Keys", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Database Models / Important Constraints", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All records use UUID strings from utils.generate_uuid(), never auto-increment, for robust unique identifiers."}, {"id": "claude_radar_charts", "label": "Radar Charts (tension visualization)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Tension Tracking System", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chart.js radar charts show tension distribution around the wheel (blue=left, purple=right, red=max recommended)."}, {"id": "claude_htmx_partial_updates", "label": "HTMX Partial Updates", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Key Design Decisions #9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Partial page updates without full reload for component selection and tension reading badges."}, {"id": "claude_progressive_build_creation", "label": "Progressive Build Creation", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Key Design Decisions #7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds need only a name; components can be filled in later, so partial builds are allowed."}, {"id": "claude_single_user_per_instance", "label": "Single-User Per Instance (no auth)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Key Design Decisions #1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No authentication for simpler self-hosted deployment."}, {"id": "claude_sqlite_storage", "label": "SQLite Database Storage", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Database Management / Key Design Decisions #2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lightweight file-based DB, easy backup; stored at ~/code/container_data/wheel_builder.db, shared between local dev (via ./data symlink) and Docker volume mount."}, {"id": "claude_docker_deployment", "label": "Docker Deployment (create-container-wheelbuilder.sh)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Development Commands > Deployment", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationa